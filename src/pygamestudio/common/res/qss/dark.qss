/* ----- General ----- */
QWidget {
    color: #cccccc;
    background-color: #1e1e1e;
}

QSplitter {
    background-color: #282828;
}

QSplitter::handle {
    background-color: #000000;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QPushButton {
    background-color: #2e2f30;
    border-radius: 5px;
    padding: 5px;
    outline: none;
}

QPushButton:disabled {
    color: gray;
}

QPushButton:hover {
    background-color: #404142;
}

QPushButton:pressed {
    background-color: #28292a;
}

QLineEdit {
    border-radius: 5px;
    border: 1px solid #3c3c3c;
    padding: 3px;
}

QLineEdit:hover {
    border: 1px solid #007acc;
}

QLineEdit:focus {
    border: 1px solid #007acc;
}

QLineEdit[drop_state="valid"] {
    border: 1px solid #007acc;
}

QLineEdit[drop_state="invalid"] {
    border: 1px solid #ff0000;
}

QSpinBox, QDoubleSpinBox {
    border-radius: 5px;
    border: 1px solid #3c3c3c;
    padding: 3px;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border: 1px solid #007acc;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #007acc;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    width: 10px;
    border: none;
    border-image: none;
    padding-right: 2px;
    subcontrol-position: top right;
}

QSpinBox::up-button, QDoubleSpinBox::down-button {
    width: 10px;
    border: none;
    border-image: none;
    padding-right: 2px;
    subcontrol-position: bottom right;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    width: 10px;
    height: 10px;
    image: url(:/images/up_arrow.png);
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    width: 10px;
    height: 10px;
    image: url(:/images/down_arrow.png);
}

QSpinBox QLabel, QDoubleSpinBox QLabel {
    background-color: #1e1e1e;
}

QComboBox {
    border-radius: 5px;
    padding: 0px 6px;
    padding-right: 2px;
    border: 1px solid #3c3c3c;
    min-height: 26px;
}

QComboBox:hover {
    border: 1px solid #007acc;
}

QComboBox::item {
    width: 20px;
    height: 26px;
    padding-left: -20px;
}

QComboBox::item:hover, QComboBox::item:selected {
    background-color: #007acc;
    padding-left: -20px;
}

QComboBox::drop-down {
    width: 15px;
    border: 0px;
}

QComboBox::down-arrow {
    image: url(:/images/down_arrow.png);
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #1e1e1e;
    color: #cccccc;
    border: 1px solid #3c3c3c;
    selection-background-color: #007acc;
    selection-color: #ffffff;
    outline: 0px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #007acc;
}

QMenu {
    background-color: #1e1e1e;
    color: #cccccc;
    border: 1px solid #3c3c3c;
    border-radius: 5px;
}

QMenu::item {
    padding: 5px 20px 5px 20px;
    border: 1px solid transparent;
}

QMenu::item:disabled {
    color: gray;
}

QMenu::item:selected {
    background-color: #404142;
    color: #ffffff;
}

QMenu::icon {
    position: relative;
    left: 15px;
}

QMenu::separator {
    height: 1px;
    background-color: #3c3c3c;
    margin: 4px 8px;
}

QMenuBar {
    border-bottom: 2px solid black;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 12px;
    margin-bottom: 4px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #404142;
}

QMenuBar::item:pressed {
    background-color: #404142;
}

QTabBar::tab {
    color: #cccccc;
    padding: 5px 12px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    min-width: 65px;
}

QTabBar::tab:selected {
    color: #ffffff;
    border-bottom: 2px solid #007acc;
}

QTabBar::tab:hover:!selected {
    background-color: #282828;
    color: #cccccc;
}

QTabWidget::tab-bar {
    alignment: left;
}

QTreeView {
    background-color: #282828;
    color: #cccccc;
    border: none;
    outline: none;
}

QTreeView::item:selected {
    background-color: #007acc;
    color: #ffffff;
}

QTreeView::item:hover:!selected {
    background-color: #404142;
}

QTreeView::item:selected:!active {
    background-color: #e0007acc;
    color: #cccccc;
}

QTreeView::branch:selected {
    background-color: #007acc;
}

QTreeView::branch:hover:!selected {
    background-color: #404142
}

QTreeView::branch:selected:!active {
    background-color: #e0007acc;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/images/tree_arrow_right.png);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/images/tree_arrow_down.png);
} 

QCheckBox {
    background-color: transparent;
}

QCheckBox::indicator {
    border-radius: 5px;
    border: 1px solid #404142;
    background-color: #282828;
    width: 14px;
    height: 14px;
}

QCheckBox::indicator:hover {
    border-color: #007acc;
}

QCheckBox::indicator:checked {
    image: url(:/images/check.png);
}

QScrollBar:vertical {
    background-color: #1e1e1e;
    width: 10px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #5a5a5a;
    min-height: 30px;
    border-radius: 7px;
    margin: 2px 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #6e6e6e;
}

QScrollBar::handle:vertical:pressed {
    background-color: #8a8a8a;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background-color: #1e1e1e;
}

QScrollBar:horizontal {
    background-color: #1e1e1e;
    height: 10px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #5a5a5a;
    min-width: 30px;
    border-radius: 7px;
    margin: 2px 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #6e6e6e;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #8a8a8a;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background-color: #1e1e1e;
}

QListWidget {
    background-color: #282828;
}

QListWidget::item {
    height: 30px;
}

QProgressBar {
    border: 1px solid lightgray;
    border-radius: 3px;
    text-align: center;
    background-color: qlineargradient(x1:1, y1:0, x2:1, y2:0.4, stop:0 white, stop:1 #dedede);
    color: #1e1e1e;
    font-weight: bold;
    height: 10px;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:1, y1:0, x2:1, y2:0.4, stop:0 white, stop:1 #007acc);
    border-radius： 2px;
}

/* ----- Window Base ----- */
QWidget#windowBaseCentralWidget {
    border-radius: 9px;
}

QWidget#windowTtitleBase {
    border-radius: 9px;
}

QLabel#windowTitleBaseNameLabel {
    font-weight: bold;
    color: #ffffff;
}

QPushButton#windowTitleBaseMinimizeBtn, QPushButton#windowTitleBaseMaximizeBtn, QPushButton#windowTitleBaseCloseBtn {
    background-color: transparent;
    border: none;
}

QPushButton#windowTitleBaseMinimizeBtn:hover, QPushButton#windowTitleBaseMaximizeBtn:hover {
    background-color: #404142;
    border-radius: 5px;
}

QPushButton#windowTitleBaseMinimizeBtn:pressed, QPushButton#windowTitleBaseMaximizeBtn:pressed {
    background-color: #28292a;
    border-radius: 5px;
}

QPushButton#windowTitleBaseCloseBtn:hover {
    background-color: red;
    border-radius: 5px;
}

QPushButton#windowTitleBaseCloseBtn:pressed {
    background-color: #941520;
    border-radius: 5px;
}

/* ----- Dashboard ----- */
QLabel#dashboardRenameProjectErrorLabel, QLabel#dashboardCreateProjectErrorLabel {
    color: red;
}

QLineEdit#dashboardSearchLineEdit {
    padding-left: 21px;
}

QListView#dashboardListView {
    background-color: #282828;
    outline: none;
}

QListView#dashboardListView::item {
    height: 80px;
    padding: 2px;
}

QListView#dashboardListView::item:selected {
    background-color: #28292a;
    border: 1px solid #cccccc;
}

QListView#dashboardListView::item:hover:!selected {
    background-color: #404142;
}

/* ----- Asset ----- */
QTreeView#assetTreeView {
    padding-top: 2px;
}

QLineEdit#assetSearchLineEdit {
    padding-left: 21px;
}

QWidget#asset QPushButton {
    background-color: transparent;
    border:none;
    padding: 3px, 3px;
}

QWidget#asset QPushButton:hover {
    background-color: #404142;
    border-radius: 5px;
}

QWidget#asset QPushButton:pressed {
    background-color: #28292a;
    border-radius: 5px;
}

/* ----- Hierarchy ----- */
QTreeView#hierarchyTreeView {
    padding-top: 2px;
}

QLineEdit#hierarchySearchLineEdit {
    padding-left: 21px;
}

QWidget#hierarchy QPushButton {
    background-color: transparent;
    border:none;
    padding: 3px, 3px;
}

QWidget#hierarchy QPushButton:hover {
    background-color: #404142;
    border-radius: 5px;
}

QWidget#hierarchy QPushButton:pressed {
    background-color: #28292a;
    border-radius: 5px;
}

/* ----- Console ----- */
QTextBrowser#consoleLogBrowser {
    background-color: #282828;
    padding-left: 4px;
    padding-top: 4px;
}

QLineEdit#consoleSearchLineEdit {
    padding-left: 21px;
}

/* ----- Scene ----- */
QPushButton#sceneRunProjectBtn, QPushButton#sceneRefreshBtn {
    background-color: #1e1e1e;
}

QPushButton:hover#sceneRunProjectBtn, QPushButton:hover#sceneRefreshBtn {
    background-color: #404142;
}

QPushButton:pressed#sceneRunProjectBtn, QPushButton:pressed#sceneRefreshBtn {
    background-color: #28292a;
}

/* ----- Inspector ----- */
QWidget#inspector, QWidget#inspectorContainer {
    background-color: #282828;
}

QWidget#inspector QPushButton {
    background-color: transparent;
    border:none;
    padding: 3px, 3px;
}

QWidget#inspector QPushButton:hover {
    background-color: #404142;
    border-radius: 5px;
}

QWidget#inspector QPushButton:pressed {
    background-color: #28292a;
    border-radius: 5px;
}

QWidget#inspectorContainer QLineEdit:disabled {
    color: gray;
}

QWidget#inspectorContainer QLabel {
    background-color: #282828;
}

QWidget#inspectorContainer QWidget#polygonPointsWidget {
    background-color: #282828;
}

QWidget#inspectorContainer QWidget#polygonPointsWidget QWidget#polygonPointsWidgetPairs {
    background-color: #282828;
}

QWidget#inspectorContainer QCheckBox::indicator {
    background-color: #1e1e1e;
}

QWidget#inspectorContainer QCheckBox::indicator:hover {
    border: 1px solid #007acc;
}

QWidget#inspectorContainer QSpinBox:disabled, QWidget#inspectorContainer QDoubleSpinBox:disabled {
    color: gray;
}

/* ----- About ----- */
QLabel#aboutCopyrightLabel {
    font-size: 10px;
    color: gray;
}

/* ----- Code Editor ----- */
QPlainTextEdit#codeEditor {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: none;
    selection-background-color: #404142;
}

QWidget#codeEditorWindow QLabel#codeEditorStatus {
    color: #6a9955;
    background-color: transparent;
}

QPushButton#codeEditorDetachBtn {
    background-color: transparent;
    border: none;
    color: #cccccc;
    padding: 4px 10px;
    border-radius: 4px;
}

QPushButton#codeEditorDetachBtn:hover {
    background-color: #404142;
}

QPushButton#codeEditorDetachBtn:pressed {
    background-color: #28292a;
}

QPushButton#codeEditorZoomInBtn, QPushButton#codeEditorZoomOutBtn {
    background-color: transparent;
    border: none;
    border-radius: 4px;
}

QPushButton#codeEditorZoomInBtn:hover, QPushButton#codeEditorZoomOutBtn:hover {
    background-color: #404142;
}

QPushButton#codeEditorZoomInBtn:pressed, QPushButton#codeEditorZoomOutBtn:pressed {
    background-color: #28292a;
}

QWidget#imageEditorWindow {
    background-color: #252526;
}

QWidget#imageEditorWindow QLabel {
    color: #9d9d9d;
    background-color: transparent;
}

QScrollArea#imageEditorScrollArea {
    background-color: #1e1e1e;
    border: none;
}

QScrollArea#imageEditorScrollArea > QWidget > QWidget {
    background-color: #1e1e1e;
}

QPushButton#imageEditorToolBtn, QPushButton#imageEditorViewBtn {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    color: #d4d4d4;
}

QPushButton#imageEditorToolBtn:hover, QPushButton#imageEditorViewBtn:hover {
    background-color: #404142;
}

QPushButton#imageEditorToolBtn:pressed, QPushButton#imageEditorViewBtn:pressed {
    background-color: #28292a;
}

QWidget#imageEditorWindow QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    color: #d4d4d4;
}

QWidget#imageEditorWindow QToolButton:hover {
    background-color: #404142;
}

QWidget#imageEditorWindow QToolButton:pressed {
    background-color: #28292a;
}

QWidget#imageEditorWindow QToolButton:checked {
    background-color: #0e639c;
    color: #ffffff;
}

QWidget#imageEditorWindow QToolButton[active="true"] {
    background-color: #0e639c;
    color: #ffffff;
}

QListView#codeEditorCompletionPopup {
    background-color: #252526;
    color: #cccccc;
    border: 1px solid #404142;
    outline: none;
}

QListView#codeEditorCompletionPopup::item {
    padding: 2px 6px;
}

QListView#codeEditorCompletionPopup::item:hover {
    background-color: #282828;
    color: #cccccc;
}

QListView#codeEditorCompletionPopup::item:selected {
    background-color: #007acc;
    color: #ffffff;
}

